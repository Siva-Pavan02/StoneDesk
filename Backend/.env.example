PORT=5000
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://kwxjvtmmjljzdrjjdfoo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only Supabase secret keys; never add these to frontend variables.
# Use one key per component so a leak only needs that key rotated:
# SUPABASE_STORAGE_SECRET_KEY=sb_secret_REPLACE_ME   # private logo storage
# SUPABASE_ADMIN_SECRET_KEY=sb_secret_REPLACE_ME     # Auth user deletion and scripts/cleanupAuthUsers.js
# Shared fallback used when a component key above is not set:
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# LOGO_STORAGE=supabase
# SUPABASE_LOGO_BUCKET=stonedesk-logos

# Database (Supabase PostgreSQL with Prisma)
# Copy both strings from the Supabase dashboard "Connect" dialog. Shapes below are
# placeholders only; the pooler host cannot be derived from the region.
#
# DATABASE_URL is runtime query traffic. On serverless compute (Vercel) use the
# shared pooler in TRANSACTION mode, port 6543: it expects many short-lived
# connections. pgbouncer=true disables prepared statements, which transaction mode
# does not support. connection_limit=1 caps the warm instance, not the request;
# raise it only with evidence that invocations queue for the connection.
# Note the pooled username form postgres.[PROJECT-REF].
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[INDEX]-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# DIRECT_URL is schema and admin work only (prisma migrate/db push, scripts/).
# Never point migrations at the transaction pooler. Direct connections are IPv6
# unless the project has the IPv4 add-on; on an IPv4-only network use the shared
# pooler in SESSION mode (same host as above, port 5432) instead.
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# A persistent backend (local, Render) can use the direct or session connection for
# DATABASE_URL as well; the transaction pooler is only required for serverless.

# Optional test database connection strings (point to a disposable database schema).
# Tests create and drop schemas, so use a direct or session connection, not port 6543.
# TEST_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# TEST_DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Upstash Redis (Distributed Rate Limiting)
# Get from https://console.upstash.com/ -> Create Database -> REST API section
# Required in production/Vercel: auth attempts return 503 on missing credentials or Redis outages.
# Development/test only: in-memory fallback is available.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# SMTP Email Configuration (Password Resets)
# If omitted, password reset emails will fail with an error.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM="StoneDesk <noreply@stonedesk.app>"

# Production settings:
# NODE_ENV=production
#   Load-bearing for security, not just logging: the session cookie only gets its
#   Secure flag when NODE_ENV is exactly "production", and APP_ORIGIN becomes
#   mandatory with every non-matching Origin rejected.
# UPLOAD_DIR should be persistent and private to this backend.
#   Ignored when LOGO_STORAGE=supabase, and unusable on serverless compute.

# TRUST_PROXY=1
#   Set to 1 only when a proxy you control sits in front of this backend, such as
#   the Vercel edge. It enables Express "trust proxy" so req.ip reads the client
#   address from X-Forwarded-For instead of the proxy. Authentication rate limits
#   are keyed on req.ip, so getting this wrong either shares one budget across all
#   callers or lets a caller spoof the header. Confirm the forwarded value before
#   enabling it.

# SERVE_FRONTEND=true
#   Single-origin deployments only: serves Frontend/dist from this process. Must be
#   unset or false for the separate Vercel backend project, which rejects it at
#   startup. express.static is ignored on Vercel in any case.

# HOST=127.0.0.1
#   Listener bind address for server.js. Local and Render only; the serverless
#   entrypoint (app.js) never binds a port.

